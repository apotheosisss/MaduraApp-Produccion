<?xml version="1.0" encoding="utf-8"?>
<!--
    Política de seguridad de red (OWASP A02: cifrado en tránsito).

    Por defecto se PROHÍBE el tráfico HTTP en claro: toda comunicación con el
    backend debe ir por HTTPS/TLS. La única excepción es el desarrollo local
    (emulador y backend en la misma máquina vía `adb reverse`), donde no hay
    red pública de por medio.
-->
<network-security-config>

    <!-- Producción y túneles (cloudflared, AWS): solo HTTPS. -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Desarrollo local únicamente: permite HTTP hacia el equipo del dev. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Backend desplegado en AWS (Elastic IP fija) para la demo en clase. -->
        <domain includeSubdomains="false">3.215.43.61</domain>
    </domain-config>

</network-security-config>
