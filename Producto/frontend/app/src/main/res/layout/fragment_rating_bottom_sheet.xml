<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/md_theme_surface">

    <TextView
        android:id="@+id/tvRatingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rating_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_on_surface"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvRatingSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rating_subtitle"
        android:textSize="13sp"
        android:textColor="@color/md_theme_on_surface"
        android:alpha="0.7"
        android:gravity="center"
        android:layout_marginTop="4dp" />

    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:numStars="5"
        android:rating="0"
        android:stepSize="1"
        style="@style/Widget.AppCompat.RatingBar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkip"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/rating_skip" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitRating"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/rating_submit"
            android:enabled="false" />

    </LinearLayout>

</LinearLayout>
