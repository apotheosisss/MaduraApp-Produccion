# ─────────────────────── Backend FastAPI ───────────────────────
API_PORT=8000
YOLO_MODEL_PATH=weights/yolo26n_maduraapp.pt
CONFIDENCE_THRESHOLD=0.65

# Desarrollo: SQLite local
DB_URL=sqlite+aiosqlite:///./maduraapp_dev.db
# Producción: PostgreSQL (usar conexión TLS y cifrado en reposo en el servidor)
# DB_URL=postgresql+asyncpg://user:password@host:5432/maduraapp

# development | production. En 'production' la app exige JWT fuerte y CORS acotado.
ENVIRONMENT=development

# ─────────────────────── Seguridad (OWASP) ─────────────────────
# Firma de los tokens JWT. OBLIGATORIO en producción (>= 32 caracteres).
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CAMBIA_ESTO_EN_PRODUCCION
JWT_EXPIRE_DAYS=30

# Orígenes permitidos para CORS, separados por coma.
# En producción NO puede ser "*". Ej: https://maduraapp.example.com
CORS_ORIGINS=*
